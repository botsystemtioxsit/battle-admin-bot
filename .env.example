# Токен бота, выданный @BotFather (команда /newbot)
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Публичный HTTPS-адрес, где размещён public/admin.html (Firebase Hosting,
# GitHub Pages, Netlify и т.п.). Telegram Mini App обязательно требует HTTPS.
MINI_APP_URL=https://example.com/admin.html

# Только для деплоя через api/telegram-webhook.js (Vercel) — не нужен для
# bot/index.js (long polling). Случайная строка, которую Telegram будет
# присылать заголовком при каждом запросе к вебхуку — без неё URL функции
# сам по себе единственная защита эндпоинта. Сгенерировать: любая
# случайная строка от 1 до 256 символов, например
# `openssl rand -hex 24`. Указывается и здесь, и при регистрации вебхука
# (см. README → "4. Задеплоить" → Vercel).
WEBHOOK_SECRET=

# ===== Ассистент панели (api/claude-assistant.js) =====
# Ключ Anthropic API (https://console.anthropic.com/settings/keys) — это
# реальные деньги, в отличие от публичных ключей Firebase в этом проекте.
# Задаётся ТОЛЬКО в переменных окружения Vercel, никогда в клиентском коде.
# Без него вкладка "Ассистент" в панели будет отвечать ошибкой.
ANTHROPIC_API_KEY=

# Необязательно — та же идея, что WEBHOOK_SECRET выше: общий секрет, который
# admin.html присылает заголовком X-Assistant-Secret. Не настоящий контроль
# доступа (сам эндпоинт публичный), просто отсекает случайное сканирование
# URL ботами. Сгенерировать: `openssl rand -hex 24`.
ASSISTANT_SECRET=
