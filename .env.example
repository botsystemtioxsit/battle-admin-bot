# Токен бота, выданный @BotFather (команда /newbot)
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Публичный HTTPS-адрес, где размещён public/admin.html (Firebase Hosting,
# GitHub Pages, Netlify и т.п.). Telegram Mini App обязательно требует HTTPS.
MINI_APP_URL=https://example.com/admin.html

# Только для деплоя через api/telegram-webhook.js (Vercel) — не нужен для
# bot/index.js (long polling). Случайная строка, которую Telegram будет
# присылать заголовком при каждом запросе к вебхуку — без неё URL функции
# сам по себе единственная защита эндпоинта. Сгенерировать: любая
# случайная строка от 1 до 256 символов, например
# `openssl rand -hex 24`. Указывается и здесь, и при регистрации вебхука
# (см. README → "4. Задеплоить" → Vercel).
WEBHOOK_SECRET=

# ===== Ассистент панели (см. вкладку "Ассистент" в src/admin.html) =====
# Ключ Anthropic API (https://console.anthropic.com/settings/keys) — это
# реальные деньги, в отличие от публичных ключей Firebase в этом проекте.
# Основной способ запуска — GitHub Actions (.github/workflows/assistant.yml):
# ключ туда добавляется НЕ через этот .env-файл, а через
# Settings → Secrets and variables → Actions → New repository secret
# прямо на странице этого репозитория на github.com (то же место, тем же
# аккаунтом, которым вы уже пушите код). .env этому способу не нужен вообще.
#
# Переменная ниже (ANTHROPIC_API_KEY) и следующая (ASSISTANT_SECRET) нужны
# ТОЛЬКО альтернативному способу — api/claude-assistant.js на Vercel
# (мгновенный ответ вместо задержки в десятки секунд, но требует один раз
# завести бесплатный проект на vercel.com). Если используете GitHub
# Actions — оставьте обе пустыми, они не читаются.
ANTHROPIC_API_KEY=

# Необязательно, только для Vercel-варианта — та же идея, что WEBHOOK_SECRET
# выше: общий секрет, который admin.html присылает заголовком
# X-Assistant-Secret. Не настоящий контроль доступа (сам эндпоинт
# публичный), просто отсекает случайное сканирование URL ботами.
# Сгенерировать: `openssl rand -hex 24`.
ASSISTANT_SECRET=
