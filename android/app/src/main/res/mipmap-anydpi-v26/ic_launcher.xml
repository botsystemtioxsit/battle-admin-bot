<?xml version="1.0" encoding="utf-8"?>
<!-- Адаптивный значок (Android 8+): система сама режет его по форме темы (круг, «квадрат с углами»…)
     и двигает слои. monochrome — слой для «тематических значков» (Android 13+): без него launcher
     красит значок в цвета обоев как попало. Для Android 7 остаются обычные PNG ic_launcher.png. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
