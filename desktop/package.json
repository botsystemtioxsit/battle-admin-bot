{
  "name": "battle-admin-desktop",
  "version": "1.0.4",
  "private": true,
  "description": "Десктоп-приложение (Electron) для панели администратора БАТТЛ — окно, которое открывает живую панель без браузера.",
  "author": {
    "name": "botsystemtioxsit",
    "email": "botsystemtioxsit@users.noreply.github.com"
  },
  "homepage": "https://github.com/botsystemtioxsit/battle-admin-bot",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.tioxsit.battleadmin",
    "productName": "БАТТЛ Админ",
    "publish": {
      "provider": "github",
      "owner": "botsystemtioxsit",
      "repo": "battle-admin-bot",
      "releaseType": "release"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "Utility",
      "icon": "icon.png",
      "artifactName": "${name}-${version}-${arch}.${ext}",
      "extraFiles": [
        { "from": "install-launcher.sh", "to": "install-launcher.sh" },
        { "from": "icon.png", "to": "icon.png" }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.png"
    }
  }
}
